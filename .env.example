# ---------------------------------------------------------------------------
# DEVSPACE 3.0 environment
# Copy this file to .env.local. Never commit .env.local or real credentials.
# ---------------------------------------------------------------------------

# Supabase (production path). Leave blank to run the local PGlite fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional canonical origin used in Supabase confirmation/reset redirects.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL connection used by Drizzle (Supabase pooler / direct connection).
DATABASE_URL=
DIRECT_URL=

# Server-only. Used for Supabase Storage and account administration.
SUPABASE_SERVICE_ROLE_KEY=

# When true, registration creates already-confirmed users through the Supabase
# Admin API instead of sending a confirmation email. Use only when SMTP is not
# configured; set to false once custom SMTP and confirmation emails are ready.
SUPABASE_SKIP_EMAIL_CONFIRMATION=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional: override the local database/storage directory (defaults to ./.data)
DEVSPACE_DATA_DIR=

# Optional, server-only. Read-only GitHub token used by the GitHub page's
# "Private" section. Private repositories are shown only when the connected
# GitHub username matches the token owner; the value never reaches the browser.
# Prefer a fine-grained token limited to the private repositories you want
# listed here.
GITHUB_PRIVATE_TOKEN=


