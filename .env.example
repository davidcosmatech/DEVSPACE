# ---------------------------------------------------------------------------
# DEVSPACE 3.0 environment
# Copy this file to .env.local. Never commit .env.local or real credentials.
# ---------------------------------------------------------------------------

# Supabase (production path). Leave blank to run the local PGlite fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional canonical origin used in Supabase confirmation/reset redirects.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL connection used by Drizzle (Supabase pooler / direct connection).
DATABASE_URL=
DIRECT_URL=

# Server-only. Used for Supabase Storage and account administration.
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional: override the local database/storage directory (defaults to ./.data)
DEVSPACE_DATA_DIR=
